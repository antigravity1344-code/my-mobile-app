# آدرس پایه API برای کلاینت (Expo). روی گوشی از میزبان LAN استفاده کنید، نه localhost.
# اگر خالی باشد، apiClient میزبان را از Expo hostUri می‌گیرد: http://<host>:3000/api
EXPO_PUBLIC_API_URL=http://192.168.1.2:3000/api

# --- سرور (server/.env یا همین فایل ریشه) ---
# الزامی برای ورود مدیر. بدون این متغیر، ورود Admin غیرفعال است و هیچ رمز پیش‌فرضی وجود ندارد.
PAKSHO_ADMIN_PASSWORD=replace-with-a-strong-password

# development | production
NODE_ENV=development

# پورت سرور
PORT=3000

# کلید ۳۲ بایتی برای رمز کد ملی و شبا. مقدار واقعی فقط در server/.env باشد.
# PAKSHO_DATA_ENCRYPTION_KEY=

# پیامک OTP با VerifyLookup کاوه‌نگار. مقدار واقعی فقط در server/.env باشد.
# KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE=
