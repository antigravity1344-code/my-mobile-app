{
  "expo": {
    "name": "پاکشو - متخصصین",
    "slug": "pakshu-worker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pakshu-worker",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pakshu.worker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.pakshu.worker",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "پاکشو برای ارسال مدرک هویتی متخصص به دسترسی گالری نیاز دارد.",
          "cameraPermission": "پاکشو برای تهیه تصویر مدرک هویتی به دوربین نیاز دارد."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
